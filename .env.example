# Copy to .env and edit. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Database: "mysql" (default) or "sqlite" (quick local trial only)
DB_ENGINE=mysql
DB_NAME=hospital_db
DB_USER=hms_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
